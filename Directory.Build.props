<Project>
  <!-- Applies to every project under this folder. Settings live here once, instead of
       being copied (and drifting) across a dozen project files. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers and warnings">
    <!-- A warning nobody has to fix is a warning nobody reads. Every warning fails the
         build, so the codebase never collects them. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The same for warnings raised by MSBuild targets (SDKs, Aspire), not only the compiler. -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>

    <!-- The .NET analyzers at their recommended level, plus the .editorconfig style rules
         enforced during the build, not only in the IDE. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Required for IDE0005 (unnecessary usings) to run in the build. Missing XML
         comments (CS1591) are turned off in .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Vulnerable-package advisories stay warnings: an advisory published after a tag
         must not stop readers from building that tag. CI reports them separately. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</MSBuildWarningsNotAsErrors>
  </PropertyGroup>
</Project>
