<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org. <clear /> drops any feeds configured on the machine, so every
       developer and CI restore the same packages from the same place. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
