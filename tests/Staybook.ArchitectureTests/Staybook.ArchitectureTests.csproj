<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables run by Microsoft Testing Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
  </ItemGroup>

  <!-- Every project whose architecture is checked. New modules are added here; a test
       fails if a module folder exists without being listed in StaybookArchitecture. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Staybook.SharedKernel\Staybook.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Staybook.Identity\Staybook.Identity.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Staybook.Identity.Contracts\Staybook.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Listings\Staybook.Listings\Staybook.Listings.csproj" />
    <ProjectReference Include="..\..\src\Modules\Listings\Staybook.Listings.Contracts\Staybook.Listings.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Pricing\Staybook.Pricing\Staybook.Pricing.csproj" />
    <ProjectReference Include="..\..\src\Modules\Pricing\Staybook.Pricing.Contracts\Staybook.Pricing.Contracts.csproj" />
  </ItemGroup>

</Project>
